---
import Layout from "../layouts/Layout.astro";

// Replace this with your own form ID once you've created the Google Form.
// In Google Forms: Send → the < > (embed) tab → copy the URL out of the
// iframe snippet. It looks like:
//   https://docs.google.com/forms/d/e/1FAIpQLSc.../viewform?embedded=true
// Paste just the ID (the long 1FAIpQLSc... part) below.
const GOOGLE_FORM_ID = "YOUR_FORM_ID";

const embedUrl = `https://docs.google.com/forms/d/e/${GOOGLE_FORM_ID}/viewform?embedded=true`;
const directUrl = `https://docs.google.com/forms/d/e/${GOOGLE_FORM_ID}/viewform`;
---

<Layout title="Contact — Aimplify">
	<h1>Contact</h1>
	<p class="lead">Questions, ideas, or want to get involved? Send us a note.</p>

	<iframe
		src={embedUrl}
		title="Contact form"
		class="form-embed"
		loading="lazy"
	>
		Loading…
	</iframe>

	<p class="fallback">
		Form not loading? <a href={directUrl} target="_blank" rel="noopener">
			Open it in a new tab</a>.
	</p>
</Layout>

<style>
	.form-embed {
		width: 100%;
		/* Google sizes its own content; this is tall enough for a short form
		   and scrolls internally if the form grows. */
		height: 900px;
		border: 1px solid var(--color-border);
		border-radius: 6px;
		margin-top: 1.5rem;
		background: white;
	}

	.fallback {
		margin-top: 1rem;
		font-size: 0.9rem;
		color: var(--color-muted);
	}
</style>
