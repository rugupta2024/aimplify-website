---
import { url } from "../lib/url";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "A community built around shared ideas and projects." } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<nav>
				<a class="brand" href={url("/")}>Aimplify</a>
				<div class="links">
					<a href={url("/#about")}>About</a>
					<a href={url("/contact")}>Contact</a>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} Aimplify. All rights reserved.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #fafaf9;
		--color-text: #1c1917;
		--color-muted: #57534e;
		--color-accent: #0f766e;
		--color-border: #e7e5e4;
		--max-width: 720px;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		color: var(--color-text);
		background: var(--color-bg);
		line-height: 1.6;
	}

	a {
		color: var(--color-accent);
	}

	.site-header {
		border-bottom: 1px solid var(--color-border);
	}

	.site-header nav {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 1.5rem;
	}

	.brand {
		font-weight: 700;
		text-decoration: none;
		color: var(--color-text);
	}

	.links a {
		margin-left: 1.5rem;
		text-decoration: none;
		color: var(--color-text);
	}

	.links a:hover {
		color: var(--color-accent);
	}

	main {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 3rem 1.5rem;
		min-height: 60vh;
	}

	.site-footer {
		border-top: 1px solid var(--color-border);
		text-align: center;
		padding: 1.5rem;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	h1 {
		font-size: 2.25rem;
		margin-bottom: 0.5rem;
	}

	.lead {
		color: var(--color-muted);
		font-size: 1.125rem;
	}
</style>
