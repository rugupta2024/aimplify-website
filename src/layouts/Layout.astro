---
import { url } from "../lib/url";

interface Props {
	title: string;
	description: string;
	ogTitle?: string;
	ogDescription?: string;
}

const { title, description, ogTitle = title, ogDescription = description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
		<meta name="description" content={description} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:type" content="website" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Caveat:wght@500;700&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--navy: #0f2b46;
		--blue: #1573e6;
		--blue-dark: #0b57c2;
		--slate: #3d5a75;
		--slate-light: #6d879f;
		--tint-blue: #eef6fd;
		--tint-green: #eff9f4;
		--tint-peach: #fdf3ea;
		--tint-grey: #f4f7fb;
		--pad-x: clamp(24px, 5vw, 72px);
		--wrap: 1180px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		/* Sticky nav is 64px tall; keep anchor targets clear of it. */
		scroll-padding-top: 80px;
	}

	body {
		margin: 0;
		background: #fff;
		color: var(--navy);
		font-family: Figtree, system-ui, -apple-system, "Segoe UI", sans-serif;
		text-wrap: pretty;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: var(--blue);
		text-decoration: none;
	}

	a:hover {
		color: var(--blue-dark);
	}

	:focus-visible {
		outline: 2px solid var(--blue);
		outline-offset: 3px;
	}

	::selection {
		background: #d7e9fd;
	}

	img {
		max-width: 100%;
	}

	svg {
		flex: none;
	}

	h1,
	h2,
	h3 {
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
